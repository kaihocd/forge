{
  "name": "@forge/state",
  "version": "0.0.0",
  "private": true,
  "description": "Forge shared runtime state hub.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "forge-state": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "sync": "tsx scripts/sync.ts",
    "check": "pnpm lint:check && pnpm typecheck && pnpm format:check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:check": "oxlint src scripts test",
    "lint:fix": "oxlint --fix src scripts test",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.{js,mjs,ts,json,jsonc,md,yaml,yml}\" \"*.{json,jsonc,md,yaml,yml}\"",
    "format:fix": "prettier --write \"{src,scripts,test}/**/*.{js,mjs,ts,json,jsonc,md,yaml,yml}\" \"*.{json,jsonc,md,yaml,yml}\""
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
