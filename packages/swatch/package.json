{
  "name": "@forge/swatch",
  "version": "0.0.0",
  "private": true,
  "description": "A versioned theme palette catalog with a JSON-first CLI.",
  "type": "module",
  "bin": {
    "swatch": "./dist/cli.js"
  },
  "scripts": {
    "start": "node dist/cli.js",
    "ensure": "tsx scripts/ensure.ts",
    "build": "tsx scripts/build.ts",
    "sync": "tsx scripts/sync.ts",
    "schemes:fetch": "tsx scripts/schemes-fetch.ts",
    "schemes:check": "tsx scripts/schemes-check.ts",
    "lint:check": "oxlint src scripts test",
    "lint:fix": "oxlint --fix src scripts test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.{js,mjs,ts,json,jsonc,md,yaml,yml}\" \"*.{json,jsonc,md,yaml,yml}\"",
    "format:fix": "prettier --write \"{src,scripts,test}/**/*.{js,mjs,ts,json,jsonc,md,yaml,yml}\" \"*.{json,jsonc,md,yaml,yml}\"",
    "check": "pnpm lint:check && pnpm typecheck && pnpm format:check",
    "test": "vitest run"
  },
  "dependencies": {
    "@forge/state": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "colorjs.io": "0.7.1",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
