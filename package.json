{
  "name": "forge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "prepare": "husky",
    "start": "node scripts/start.js",
    "build": "tsx scripts/build.ts",
    "sync": "tsx scripts/sync.ts",
    "sync:preview": "tsx scripts/sync.ts --preview",
    "lint": "oxlint scripts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,mjs,json,jsonc,md,yaml,yml}\" && stylua .",
    "format-check": "prettier --check \"**/*.{js,mjs,json,jsonc,md,yaml,yml}\" && stylua --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format-check"
  },
  "lint-staged": {
    "*.{js,mjs,json,jsonc,md,yaml,yml}": "prettier --write",
    "*.lua": "stylua"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@johnnymorganz/stylua-bin": "2.5.2",
    "@types/node": "26.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "oxlint": "1.75.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
